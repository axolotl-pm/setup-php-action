{
  "name": "typescript-action",
  "version": "0.0.0",
  "private": true,
  "description": "GitHub Action to set up PHP binaries for Axolotl-PM",
  "main": "lib/main.js",
  "scripts": {
    "build": "tsc",
    "format": "prettier --write \"**/*.ts\"",
    "format-check": "prettier --check \"**/*.ts\"",
    "lint": "eslint \"src/**/*.ts\"",
    "package": "ncc build --source-map --license licenses.txt",
    "all": "npm run build && npm run format && npm run lint && npm run package"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/axolotl-pm/setup-php-action.git"
  },
  "keywords": [
    "actions",
    "node",
    "setup"
  ],
  "author": "axolotl-pm",
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^1.6.0",
    "@actions/tool-cache": "^2.0.1",
    "glob": "^10.2.6"
  },
  "devDependencies": {
    "@types/node": "^16.11.26",
    "@typescript-eslint/parser": "^5.17.0",
    "@vercel/ncc": "^0.33.3",
    "eslint": "^8.12.0",
    "eslint-plugin-github": "^4.3.6",
    "prettier": "2.5.0",
    "typescript": "^4.6.3"
  }
}
